#
# PHPUnit 実行時に APP_ENV=testing で自動読込される env。
# 目的: dev コンテナの環境変数 (QUEUE_CONNECTION=redis 等) が phpunit に
# 漏れ込むのを防ぎ、テストを sync queue / array driver / sqlite で固定する。
#
# 各テストは Queue::fake() を使わない限り sync 前提で Job 完了後を assert する。
#

APP_NAME=AnkiAiFlashcard
APP_ENV=testing
APP_KEY=base64:SSwKcZo7uFkMA0yU/VIaYMPAsobUoLyZJL6Ak9USMZY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

# AI プロバイダ: テストでは FakeAiProvider を使う
DEFAULT_AI_PROVIDER=fake
DEFAULT_AI_MODEL=gpt-4o-mini

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
